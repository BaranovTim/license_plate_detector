# Copy to config.env and fill in. Read by the Docker container on the Jetson.

DEVICE_ID=gate-1
# Your Mac's address on the Wi-Fi + the server port (Mac: `ipconfig getifaddr en0`)
SERVER_URL=http://192.168.1.10:8080
# Printed by `python server.py add-device gate-1` on the Mac
DEVICE_TOKEN=

# Camera: auto = first /dev/ttyACM* (the XIAO), or folder:/data/anpr/test-images to replay images
CAMERA=auto
FRAME_SIZE=XGA
JPEG_QUALITY=12

# Capture: frames per second checked for motion, images saved per motion event
POLL_FPS=2
MOTION_THRESHOLD=0.02
BURST=3
BURST_INTERVAL=0.4
COOLDOWN=2

# Recognition: every character must reach MIN_CONFIDENCE; optional plate format check
MIN_CONFIDENCE=0.80
# PLATE_REGEX=^[A-Z]{3}[0-9]{3}$
DEDUPE_SECONDS=30

# Storage (DATA_DIR is mounted from the Jetson's /data/anpr)
DATA_DIR=/data/anpr
MAX_UNRECOGNIZED_MB=1000
MIN_FREE_MB=500

# Failed events keep only their best frame; true = keep the whole burst
KEEP_ALL_FAILED_FRAMES=false
